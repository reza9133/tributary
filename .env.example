# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: three different accounts on Studionet.
#   ALICE_KEY  registers the original works (the run sends about 0.2 GEN)
#   BOB_KEY    registers derivatives and the copies that get disputed         (about 0.2 GEN)
#   CAROL_KEY  files disputes as a watcher and buys licences                  (about 0.3 GEN)
# 0.5 GEN on each account is plenty.
ALICE_KEY=0x
BOB_KEY=0x
CAROL_KEY=0x

# Optional: a stranger that only sends calls that must be refused (a random account is used when empty).
OUTSIDER_KEY=

# Optional: use an existing deployment instead of deploying contracts/tributary.py first.
TRIBUTARY_ADDRESS=

# Optional tuning
# REPORT_DIR=reports
